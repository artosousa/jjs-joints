{%- liquid
  assign product = closest.product
  assign uid = block.id

  assign first_tab_content = block.settings.tab_1_content
  if first_tab_content == blank and product
    assign first_tab_content = product.description
  endif

  assign labels = block.settings.tab_1_label | append: '|||' | append: block.settings.tab_2_label | append: '|||' | append: block.settings.tab_3_label
  assign labels = labels | split: '|||'
-%}

<product-tabs class="pdp-tabs" {{ block.shopify_attributes }}>
  <div class="pdp-tabs__list" role="tablist">
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign content = first_tab_content
          when 2
            assign content = block.settings.tab_2_content
          when 3
            assign content = block.settings.tab_3_content
        endcase
        assign label = labels[forloop.index0]
      -%}
      {%- if label != blank and content != blank -%}
        <button
          type="button"
          class="pdp-tabs__tab"
          role="tab"
          id="PdpTab-{{ uid }}-{{ i }}"
          aria-controls="PdpPanel-{{ uid }}-{{ i }}"
          aria-selected="false"
          tabindex="-1"
        >
          {{ label | escape }}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- for i in (1..3) -%}
    {%- liquid
      case i
        when 1
          assign content = first_tab_content
        when 2
          assign content = block.settings.tab_2_content
        when 3
          assign content = block.settings.tab_3_content
      endcase
      assign label = labels[forloop.index0]
    -%}
    {%- if label != blank and content != blank -%}
      <div
        class="pdp-tabs__panel rte"
        role="tabpanel"
        id="PdpPanel-{{ uid }}-{{ i }}"
        aria-labelledby="PdpTab-{{ uid }}-{{ i }}"
        hidden
      >
        {{ content }}
      </div>
    {%- endif -%}
  {%- endfor -%}
</product-tabs>

{% stylesheet %}
  .pdp-tabs {
    display: block;
    width: 100%;
  }

  .pdp-tabs__list {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid #e1e1e1;
  }

  .pdp-tabs__tab {
    margin-bottom: -1px;
    padding: 0 0 10px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: #8a8a8a;
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .pdp-tabs__tab[aria-selected='true'] {
    border-bottom-color: #000;
    color: #000;
  }

  .pdp-tabs__panel {
    padding-top: 18px;
    color: #3d3d3d;
    font-size: 11px;
    line-height: 1.75;
  }

  .pdp-tabs__panel > :first-child {
    margin-top: 0;
  }

  .pdp-tabs__panel > :last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('product-tabs')) {
    customElements.define(
      'product-tabs',
      class ProductTabs extends HTMLElement {
        connectedCallback() {
          this.tabs = [...this.querySelectorAll('[role="tab"]')];
          this.tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => this.select(index));
            tab.addEventListener('keydown', (event) => {
              const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
              if (!step) return;
              const next = (index + step + this.tabs.length) % this.tabs.length;
              this.select(next);
              this.tabs[next].focus();
            });
          });
          this.select(0);
        }

        select(index) {
          this.tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            const panel = this.querySelector(`#${tab.getAttribute('aria-controls')}`);
            if (panel) panel.hidden = !selected;
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Product tabs",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Tabs without content are hidden. The first tab falls back to the product description."
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Label",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "tab_1_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Label",
      "default": "Details & Fit"
    },
    {
      "type": "richtext",
      "id": "tab_2_content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Label",
      "default": "Fabric & Care"
    },
    {
      "type": "richtext",
      "id": "tab_3_content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "Product tabs"
    }
  ]
}
{% endschema %}
