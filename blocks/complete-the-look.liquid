{%- liquid
  assign products = block.settings.products
  if products == blank and request.design_mode
    assign show_placeholder = true
  endif
-%}

{%- if products != blank or show_placeholder -%}
  <div class="pdp-look" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="pdp-look__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="pdp-look__list" role="list">
      {%- if products != blank -%}
        {%- for item in products -%}
          <li class="pdp-look__item">
            <a href="{{ item.url }}" class="pdp-look__link">
              <span class="pdp-look__media">
                {%- if item.featured_media -%}
                  {{
                    item.featured_media.preview_image
                    | image_url: width: 400
                    | image_tag: loading: 'lazy', sizes: '160px', widths: '200, 300, 400', alt: item.title
                  }}
                {%- endif -%}
              </span>
              <span class="pdp-look__title">{{ item.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="pdp-look__item">
          <span class="pdp-look__media">{{ 'product-apparel-1' | placeholder_svg_tag }}</span>
          <span class="pdp-look__title">Pick products in the block settings</span>
        </li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .pdp-look {
    width: 100%;
    padding-top: 16px;
    border-top: 1px solid #e1e1e1;
  }

  .pdp-look__heading {
    margin: 0 0 14px;
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pdp-look__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdp-look__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .pdp-look__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #e8e8e8;
  }

  .pdp-look__media img,
  .pdp-look__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-look__title {
    display: block;
    margin-top: 10px;
    font-family: 'Times New Roman', Times, Georgia, serif;
    font-size: 11px;
  }

  .pdp-look__link:hover .pdp-look__title {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complete the look",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the look"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 4,
      "info": "Connect a product list metafield to show different products per product"
    }
  ],
  "presets": [
    {
      "name": "Complete the look"
    }
  ]
}
{% endschema %}
