{%- liquid
  assign ss = section.settings
  assign source = ss.source
  assign limit = ss.max_products

  assign products = blank
  case source
    when 'collection'
      if ss.collection != blank
        assign products = ss.collection.products
      endif
    when 'related', 'complementary'
      if recommendations.performed and recommendations.products_count > 0
        assign products = recommendations.products
      endif
    when 'recently_viewed'
      if search.performed and search.results_count > 0
        assign products = search.results
      endif
  endcase

  assign current_product_id = product.id | default: ''

  case ss.image_ratio
    when 'square'
      assign image_ratio = '1 / 1'
    when 'portrait'
      assign image_ratio = '4 / 5'
    else
      assign image_ratio = '3 / 4'
  endcase

  assign sizes = '(min-width: 990px) calc(100vw / ' | append: ss.columns_desktop | append: '), calc(100vw / ' | append: ss.columns_mobile | append: ')'

  assign recommendations_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: limit | append: '&intent=' | append: source
-%}

<product-row
  class="pr pr--{{ ss.card_style }}"
  data-source="{{ source }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ current_product_id }}"
  data-limit="{{ limit }}"
  data-search-url="{{ routes.search_url }}"
  {% if source == 'related' or source == 'complementary' %}
    {% if product %}data-url="{{ recommendations_url }}"{% endif %}
  {% endif %}
  {% if products == blank and source != 'collection' %}hidden{% endif %}
  style="
    --pr-cols: {{ ss.columns_desktop }};
    --pr-cols-mobile: {{ ss.columns_mobile }};
    --pr-gap: {{ ss.gap }}px;
    --pr-ratio: {{ image_ratio }};
    --pr-fit: {{ ss.image_fit }};
    --pr-pad-top: {{ ss.padding_top }}px;
    --pr-pad-bottom: {{ ss.padding_bottom }}px;
    --pr-pad-inline: {{ ss.padding_inline }}px;
    {% if ss.image_background != blank %}--pr-image-bg: {{ ss.image_background }};{% endif %}
  "
>
  <div class="pr__inner" data-pr-inner>
    {%- if ss.heading != blank -%}
      <h2 class="pr__heading">{{ ss.heading | escape }}</h2>
    {%- endif -%}

    {%- if products != blank -%}
      <ul class="pr__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for item in products -%}
          {%- if item.object_type and item.object_type != 'product' -%}{%- continue -%}{%- endif -%}
          {%- if item.id == current_product_id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="pr-card" data-product-id="{{ item.id }}">
            <a href="{{ item.url }}" class="pr-card__link">
              <span class="pr-card__media">
                {%- if item.featured_media -%}
                  {{
                    item.featured_media.preview_image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '300, 400, 500, 600, 800, 1000',
                      alt: item.title
                  }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                {%- endif -%}
              </span>
              <span class="pr-card__info">
                <span class="pr-card__row">
                  <span class="pr-card__title">{{ item.title }}</span>
                  <span class="pr-card__price">
                    {%- if item.price_varies -%}From {% endif -%}
                    {{ item.price | money }}
                  </span>
                </span>
                {%- if ss.show_type and item.type != blank -%}
                  <span class="pr-card__subtitle">{{ item.type }}</span>
                {%- endif -%}
                {%- if ss.show_vendor and item.vendor != blank -%}
                  <span class="pr-card__note">{{ item.vendor }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif source == 'collection' and request.design_mode -%}
      <p class="pr__empty">Pick a collection in the section settings.</p>
    {%- endif -%}
  </div>
</product-row>

{% stylesheet %}
  .pr {
    --pr-serif: 'Times New Roman', Times, Georgia, serif;
    --pr-image-bg: #e5e5e5;

    display: block;
    padding: var(--pr-pad-top) var(--pr-pad-inline) var(--pr-pad-bottom);
  }

  .pr[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .pr {
      padding-inline: 16px;
    }
  }

  .pr__heading {
    margin: 0 0 20px;
    font-family: var(--pr-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }

  .pr__grid {
    display: grid;
    grid-template-columns: repeat(var(--pr-cols-mobile), minmax(0, 1fr));
    gap: var(--pr-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .pr__grid {
      grid-template-columns: repeat(var(--pr-cols), minmax(0, 1fr));
    }
  }

  .pr-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .pr-card__media {
    display: block;
    aspect-ratio: var(--pr-ratio);
    overflow: hidden;
    background: var(--pr-image-bg);
  }

  .pr-card__media img,
  .pr-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: var(--pr-fit);
  }

  .pr-card__info {
    display: block;
    padding: 16px 16px 0;
  }

  .pr-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .pr-card__title,
  .pr-card__price {
    font-family: var(--pr-serif);
    font-size: 12px;
    line-height: 1.3;
  }

  .pr-card__price {
    flex-shrink: 0;
  }

  .pr-card__subtitle {
    display: block;
    margin-top: 4px;
    color: #6f6f6f;
    font-size: 10px;
  }

  .pr-card__note {
    display: block;
    margin-top: 14px;
    color: #a3a3a3;
    font-size: 9px;
  }

  .pr-card__link:hover .pr-card__title {
    text-decoration: underline;
  }

  /* Stacked: title and price on separate lines, tighter info */
  .pr--stacked .pr-card__info {
    padding: 12px 4px 0;
  }

  .pr--stacked .pr-card__row {
    flex-direction: column;
    gap: 6px;
  }

  .pr__empty {
    font-size: 13px;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('product-row')) {
    customElements.define(
      'product-row',
      class ProductRow extends HTMLElement {
        connectedCallback() {
          const { source } = this.dataset;
          if (source === 'collection' || this.querySelector('.pr__grid')) return;

          const url = source === 'recently_viewed' ? this.recentlyViewedUrl() : this.dataset.url;
          if (!url) return;

          fetch(url)
            .then((response) => response.text())
            .then((html) => {
              const doc = new DOMParser().parseFromString(html, 'text/html');
              const inner = doc.querySelector('[data-pr-inner]');
              if (!inner || !inner.querySelector('.pr-card')) return;

              if (this.ids) this.sortByIds(inner);
              this.querySelector('[data-pr-inner]').replaceWith(inner);
              this.hidden = false;
            })
            .catch(() => {});
        }

        recentlyViewedUrl() {
          let ids = [];
          try {
            ids = JSON.parse(localStorage.getItem('viewedProducts') || '[]');
          } catch (error) {
            return null;
          }

          this.ids = ids.map(String).filter((id) => id !== this.dataset.productId);
          if (this.ids.length === 0) return null;

          const url = new URL(this.dataset.searchUrl, window.location.origin);
          url.searchParams.set('q', this.ids.map((id) => `id:${id}`).join(' OR '));
          url.searchParams.set('resources[type]', 'product');
          url.searchParams.set('section_id', this.dataset.sectionId);
          return url.toString();
        }

        // Search results come back in relevance order; show the most recently viewed first
        sortByIds(inner) {
          const grid = inner.querySelector('.pr__grid');
          const cards = [...grid.children];
          cards
            .sort((a, b) => this.ids.indexOf(a.dataset.productId) - this.ids.indexOf(b.dataset.productId))
            .forEach((card) => grid.append(card));
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Product row",
  "tag": "section",
  "class": "section-product-row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Styles in This Fit"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "options": [
        { "value": "related", "label": "Related products (automatic)" },
        { "value": "complementary", "label": "Complementary products" },
        { "value": "recently_viewed", "label": "Recently viewed" },
        { "value": "collection", "label": "Collection" }
      ],
      "default": "related"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when Products is set to Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between products",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "split", "label": "Title and price on one line" },
        { "value": "stacked", "label": "Title and price stacked" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "tall", "label": "Portrait (3:4)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background"
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show product type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Product row"
    }
  ]
}
{% endschema %}
