{%- liquid
  assign ss = section.settings

  case ss.image_ratio
    when 'square'
      assign image_ratio = '1 / 1'
    when 'landscape'
      assign image_ratio = '4 / 3'
    when 'tall'
      assign image_ratio = '2 / 3'
    else
      assign image_ratio = '4 / 5'
  endcase

  case ss.label_font
    when 'heading'
      assign label_font = 'var(--font-heading--family)'
    when 'accent'
      assign label_font = 'var(--font-accent--family)'
    when 'body'
      assign label_font = 'var(--font-body--family)'
    else
      assign label_font = '"Courier New", Courier, ui-monospace, monospace'
  endcase

  assign active_filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor

  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign current_sort_name = ''
  for option in collection.sort_options
    if option.value == current_sort
      assign current_sort_name = option.name
    endif
  endfor

  assign sizes = '(min-width: 990px) calc(100vw / ' | append: ss.columns_desktop | append: '), (min-width: 750px) calc(100vw / ' | append: ss.columns_tablet | append: '), calc(100vw / ' | append: ss.columns_mobile | append: ')'
-%}

<hc-collection
  class="hc-collection"
  style="
    --hc-cols: {{ ss.columns_desktop }};
    --hc-cols-tablet: {{ ss.columns_tablet }};
    --hc-cols-mobile: {{ ss.columns_mobile }};
    --hc-gap-x: {{ ss.gap_horizontal }}px;
    --hc-gap-y: {{ ss.gap_vertical }}px;
    --hc-ratio: {{ image_ratio }};
    --hc-label-font: {{ label_font }};
    --hc-pad-top: {{ ss.padding_top }}px;
    --hc-pad-bottom: {{ ss.padding_bottom }}px;
    {% if ss.image_background != blank %}--hc-image-bg: {{ ss.image_background }};{% endif %}
  "
>
  <header class="hc-header">
    <div class="hc-header__text">
      <h1 class="hc-header__title">{{ collection.title }}</h1>
      {%- if ss.show_description and collection.description != blank -%}
        <div class="hc-header__description">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    {%- if ss.show_count -%}
      <p class="hc-header__count">
        {{ collection.products_count }}
        {% if collection.products_count == 1 %}Item{% else %}Items{% endif %}
      </p>
    {%- endif -%}
  </header>

  {%- if ss.enable_sorting or ss.enable_filtering -%}
    <div class="hc-toolbar">
      {%- if ss.enable_sorting -%}
        <label class="hc-toolbar__button hc-sort">
          <span class="hc-sort__label">Sort by:</span>
          <span class="hc-sort__current" aria-hidden="true">{{ current_sort_name }}</span>
          <select class="hc-sort__select" aria-label="Sort by" data-hc-sort>
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == current_sort %}selected{% endif %}
              >
                {{ option.name | escape }}
              </option>
            {%- endfor -%}
          </select>
          <svg class="hc-sort__chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </label>
      {%- endif -%}

      <button type="button" class="hc-toolbar__button hc-filter-toggle" data-hc-open aria-haspopup="dialog">
        <span>
          Filter &amp; Sort
          {%- if active_filter_count > 0 %} ({{ active_filter_count }}){% endif -%}
        </span>
        <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true" focusable="false">
          <path d="M0 1h14M2.5 5h9M5 9h4" fill="none" stroke="currentColor" stroke-width="1.2"/>
        </svg>
      </button>
    </div>
  {%- endif -%}

  {%- paginate collection.products by ss.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="hc-grid" role="list">
        {%- for product in collection.products -%}
          {%- liquid
            assign inventory = 0
            assign tracked = false
            for variant in product.variants
              if variant.inventory_management == 'shopify' and variant.available
                assign tracked = true
                if variant.inventory_quantity > 0
                  assign inventory = inventory | plus: variant.inventory_quantity
                endif
              endif
            endfor

            assign badge = blank
            if product.available == false
              assign badge = 'sold_out'
            elsif ss.show_low_stock and tracked and inventory > 0 and inventory <= ss.low_stock_threshold
              assign badge = 'low_stock'
            elsif ss.show_sale and product.compare_at_price > product.price
              assign badge = 'sale'
            endif

            assign second_image = blank
            if ss.show_secondary_image and product.media.size > 1 and product.media[1].preview_image
              assign second_image = product.media[1].preview_image
            endif

            case ss.card_label
              when 'type'
                assign card_label = product.type
              when 'vendor'
                assign card_label = product.vendor
              else
                assign card_label = blank
            endcase
          -%}
          <li class="hc-card{% if second_image != blank %} hc-card--has-secondary{% endif %}">
            <a href="{{ product.url | within: collection }}" class="hc-card__media" tabindex="-1" aria-hidden="true">
              {%- if product.featured_media -%}
                {%- assign image_alt = product.featured_media.alt | default: product.title -%}
                {{
                  product.featured_media.preview_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'hc-card__image',
                    sizes: sizes,
                    widths: '300, 400, 500, 600, 800, 1000, 1200',
                    loading: 'lazy',
                    alt: image_alt
                }}
                {%- if second_image != blank -%}
                  {{
                    second_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'hc-card__image hc-card__image--secondary',
                      sizes: sizes,
                      widths: '300, 400, 500, 600, 800, 1000, 1200',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'hc-card__image hc-card__placeholder' }}
              {%- endif -%}

              {%- case badge -%}
                {%- when 'sold_out' -%}
                  <span class="hc-badge hc-badge--sold-out">Sold out</span>
                {%- when 'low_stock' -%}
                  <span class="hc-badge">Low stock</span>
                {%- when 'sale' -%}
                  <span class="hc-badge">Sale</span>
              {%- endcase -%}
            </a>

            <div class="hc-card__info">
              {%- if card_label != blank -%}
                <p class="hc-card__label">{{ card_label }}</p>
              {%- endif -%}
              <h2 class="hc-card__title">
                <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
              </h2>
              <p class="hc-card__price">
                {%- if product.price_varies -%}From {% endif -%}
                {%- if product.compare_at_price > product.price -%}
                  <span class="hc-card__price--sale">{{ product.price | money }}</span>
                  <s class="hc-card__price--compare">{{ product.compare_at_price | money }}</s>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </p>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="hc-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="hc-pagination__link" aria-label="Previous page">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="hc-pagination__link">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="hc-pagination__link is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="hc-pagination__link">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="hc-pagination__link" aria-label="Next page">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="hc-empty">
        <p>No products found.</p>
        {%- if active_filter_count > 0 -%}
          <a href="{{ collection.url }}{% if collection.sort_by %}?sort_by={{ collection.sort_by }}{% endif %}">Clear all filters</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}

  {%- if ss.enable_sorting or ss.enable_filtering -%}
    <dialog class="hc-drawer" data-hc-drawer aria-labelledby="HcDrawerTitle-{{ section.id }}">
      <form class="hc-drawer__form" action="{{ collection.url }}" method="get" data-hc-form>
        <div class="hc-drawer__header">
          <h2 class="hc-drawer__title" id="HcDrawerTitle-{{ section.id }}">Filter &amp; Sort</h2>
          <button type="button" class="hc-drawer__close" data-hc-close aria-label="Close">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
              <path d="M1 1l12 12M13 1L1 13" fill="none" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </button>
        </div>

        <div class="hc-drawer__body">
          {%- if ss.enable_sorting -%}
            <details class="hc-facet" open>
              <summary class="hc-facet__summary">Sort by</summary>
              <ul class="hc-facet__list" role="list">
                {%- for option in collection.sort_options -%}
                  <li>
                    <label class="hc-option">
                      <input
                        type="radio"
                        name="sort_by"
                        value="{{ option.value | escape }}"
                        {% if option.value == current_sort %}checked{% endif %}
                      >
                      <span>{{ option.name | escape }}</span>
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- elsif collection.sort_by -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by | escape }}">
          {%- endif -%}

          {%- if ss.enable_filtering -%}
            {%- for filter in collection.filters -%}
              {%- liquid
                assign is_open = false
                if filter.type == 'price_range'
                  if filter.min_value.value != null or filter.max_value.value != null
                    assign is_open = true
                  endif
                elsif filter.active_values.size > 0
                  assign is_open = true
                endif
              -%}
              <details class="hc-facet"{% if is_open %} open{% endif %}>
                <summary class="hc-facet__summary">
                  {{ filter.label | escape }}
                  {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
                </summary>
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="hc-price">
                      <label class="hc-price__field">
                        <span>From</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}"
                          placeholder="0"
                          min="0"
                          step="0.01"
                          inputmode="decimal"
                        >
                      </label>
                      <label class="hc-price__field">
                        <span>To</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}"
                          placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                          min="0"
                          step="0.01"
                          inputmode="decimal"
                        >
                      </label>
                    </div>
                  {%- else -%}
                    <ul class="hc-facet__list" role="list">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="hc-option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value | escape }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            >
                            <span>{{ value.label | escape }}</span>
                            <span class="hc-option__count">({{ value.count }})</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                {%- endcase -%}
              </details>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="hc-drawer__footer">
          <a
            href="{{ collection.url }}{% if collection.sort_by %}?sort_by={{ collection.sort_by }}{% endif %}"
            class="hc-drawer__button hc-drawer__button--secondary"
          >
            Clear all
          </a>
          <button type="submit" class="hc-drawer__button">Apply</button>
        </div>
      </form>
    </dialog>
  {%- endif -%}
</hc-collection>

{% stylesheet %}
  .hc-collection {
    --hc-muted: #767676;
    --hc-border: #1a1a1a;
    --hc-rule: #e6e6e6;
    --hc-image-bg: #f2f2f2;
    --hc-gutter: 24px;

    display: block;
    padding-block: var(--hc-pad-top) var(--hc-pad-bottom);
    color: var(--color-foreground, #000);
    font-family: var(--font-body--family);
  }

  @media screen and (max-width: 749px) {
    .hc-collection {
      --hc-gutter: 16px;
    }
  }

  /* Header */
  .hc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 0 var(--hc-gutter) 24px;
    border-bottom: 1px solid var(--hc-rule);
  }

  .hc-header__title {
    margin: 0;
    font-family: var(--hc-label-font);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hc-header__description {
    margin-top: 10px;
    max-width: 720px;
    font-size: 13px;
    line-height: 1.5;
  }

  .hc-header__description > * {
    margin: 0;
  }

  .hc-header__count {
    flex-shrink: 0;
    margin: 4px 0 0;
    font-size: 11px;
    line-height: 1.2;
  }

  /* Toolbar */
  .hc-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 24px 12px;
  }

  .hc-toolbar__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 36px;
    padding: 0 16px;
    border: 1px solid var(--hc-border);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  .hc-sort {
    min-width: 164px;
  }

  .hc-sort__label {
    margin-right: -6px;
  }

  .hc-sort__current {
    flex: 1;
  }

  .hc-sort__select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    font-size: 16px;
  }

  .hc-sort:focus-within {
    outline: 1px solid var(--hc-border);
    outline-offset: 2px;
  }

  .hc-filter-toggle {
    min-width: 104px;
  }

  @media screen and (max-width: 749px) {
    .hc-toolbar {
      padding: 16px;
    }

    .hc-toolbar__button {
      flex: 1;
      min-width: 0;
    }
  }

  /* Grid */
  .hc-grid {
    display: grid;
    grid-template-columns: repeat(var(--hc-cols-mobile), minmax(0, 1fr));
    column-gap: var(--hc-gap-x);
    row-gap: var(--hc-gap-y);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .hc-grid {
      grid-template-columns: repeat(var(--hc-cols-tablet), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .hc-grid {
      grid-template-columns: repeat(var(--hc-cols), minmax(0, 1fr));
    }
  }

  /* Card */
  .hc-card {
    min-width: 0;
  }

  .hc-card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--hc-ratio);
    overflow: hidden;
    background: var(--hc-image-bg);
  }

  .hc-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .hc-card__image--secondary {
    opacity: 0;
  }

  @media (hover: hover) {
    .hc-card--has-secondary:hover .hc-card__image--secondary {
      opacity: 1;
    }
  }

  .hc-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 3px 7px;
    border: 1px solid var(--hc-border);
    background: #fff;
    color: #000;
    font-family: var(--hc-label-font);
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hc-badge--sold-out {
    border-color: #fff;
    background: #8c8c8c;
    color: #fff;
  }

  .hc-card__info {
    padding: 12px 12px 0;
  }

  .hc-card__label {
    margin: 0 0 3px;
    color: var(--hc-muted);
    font-family: var(--hc-label-font);
    font-size: 10px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hc-card__title {
    margin: 0;
    font-family: inherit;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
  }

  .hc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .hc-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hc-card {
    position: relative;
  }

  .hc-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hc-card__price {
    margin: 3px 0 0;
    font-size: 11px;
    line-height: 1.3;
  }

  .hc-card__price--compare {
    margin-left: 4px;
    color: var(--hc-muted);
  }

  /* Pagination + empty */
  .hc-pagination {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding: 48px var(--hc-gutter) 0;
    font-size: 12px;
  }

  .hc-pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    color: inherit;
    text-decoration: none;
  }

  .hc-pagination__link.is-current {
    border: 1px solid var(--hc-border);
  }

  .hc-empty {
    padding: 64px var(--hc-gutter);
    text-align: center;
    font-size: 13px;
  }

  .hc-empty a {
    color: inherit;
  }

  /* Drawer */
  .hc-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(420px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: #000;
    transform: translateX(100%);
    transition: transform 0.3s ease, overlay 0.3s allow-discrete, display 0.3s allow-discrete;
  }

  .hc-drawer[open] {
    transform: translateX(0);
  }

  @starting-style {
    .hc-drawer[open] {
      transform: translateX(100%);
    }
  }

  .hc-drawer::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .hc-drawer__form {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hc-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--hc-rule);
  }

  .hc-drawer__title {
    margin: 0;
    font-family: var(--hc-label-font);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hc-drawer__close {
    display: inline-flex;
    padding: 6px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .hc-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 0 24px;
  }

  .hc-facet {
    border-bottom: 1px solid var(--hc-rule);
  }

  .hc-facet__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    font-family: var(--hc-label-font);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .hc-facet__summary::-webkit-details-marker {
    display: none;
  }

  .hc-facet__summary::after {
    content: '+';
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1;
  }

  .hc-facet[open] > .hc-facet__summary::after {
    content: '\2212';
  }

  .hc-facet__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0 0 20px;
    list-style: none;
  }

  .hc-option {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    cursor: pointer;
  }

  .hc-option input {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: #000;
  }

  .hc-option.is-disabled {
    opacity: 0.4;
    cursor: default;
  }

  .hc-option__count {
    color: var(--hc-muted);
  }

  .hc-price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-bottom: 20px;
  }

  .hc-price__field {
    display: grid;
    gap: 6px;
    font-size: 11px;
  }

  .hc-price__field input {
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--hc-border);
    border-radius: 0;
    font: inherit;
    font-size: 13px;
  }

  .hc-drawer__footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 16px 24px;
    border-top: 1px solid var(--hc-rule);
  }

  .hc-drawer__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    border: 1px solid #000;
    border-radius: 0;
    background: #000;
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .hc-drawer__button--secondary {
    background: #fff;
    color: #000;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('hc-collection')) {
    customElements.define(
      'hc-collection',
      class HcCollection extends HTMLElement {
        connectedCallback() {
          this.drawer = this.querySelector('[data-hc-drawer]');
          this.form = this.querySelector('[data-hc-form]');

          this.querySelector('[data-hc-sort]')?.addEventListener('change', (event) => {
            const url = new URL(window.location.href);
            url.searchParams.set('sort_by', event.target.value);
            url.searchParams.delete('page');
            window.location.href = url.toString();
          });

          this.querySelector('[data-hc-open]')?.addEventListener('click', () => this.drawer?.showModal());
          this.querySelector('[data-hc-close]')?.addEventListener('click', () => this.drawer?.close());

          // Close when clicking the backdrop
          this.drawer?.addEventListener('click', (event) => {
            if (event.target === this.drawer) this.drawer.close();
          });

          // Drop empty price inputs so they don't end up in the URL
          this.form?.addEventListener('submit', () => {
            this.form.querySelectorAll('input[type="number"]').forEach((input) => {
              if (input.value === '') input.disabled = true;
            });
          });
        }
      }
    );
  }
{% endjavascript %}

