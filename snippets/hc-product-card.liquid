{%- doc -%}
  Product card used by the collection grid and product rows. Renders a list item, so place it inside
  a list with the hc-grid class. The wrapper sets --hc-cols, --hc-cols-tablet, --hc-cols-mobile, --hc-gap-x,
  --hc-gap-y, and optionally --hc-ratio, --hc-image-bg and --hc-label-font.

  @param {product} product - The product to render
  @param {collection} [collection] - Collection context for the product URL
  @param {string} sizes - Image sizes attribute
  @param {boolean} [show_low_stock] - Show the low stock badge
  @param {number} [low_stock_threshold] - Stock level at or below which the low stock badge shows
  @param {boolean} [show_sale] - Show the sale badge
  @param {boolean} [show_secondary_image] - Show the second image on hover
  @param {string} [card_label_source] - 'type', 'vendor' or 'none'
{%- enddoc -%}

{%- liquid
  assign inventory = 0
  assign tracked = false
  for variant in product.variants
    if variant.inventory_management == 'shopify' and variant.available
      assign tracked = true
      if variant.inventory_quantity > 0
        assign inventory = inventory | plus: variant.inventory_quantity
      endif
    endif
  endfor

  assign badge = blank
  if product.available == false
    assign badge = 'sold_out'
  elsif show_low_stock and tracked and inventory > 0 and inventory <= low_stock_threshold
    assign badge = 'low_stock'
  elsif show_sale and product.compare_at_price > product.price
    assign badge = 'sale'
  endif

  assign second_image = blank
  if show_secondary_image and product.media.size > 1 and product.media[1].preview_image
    assign second_image = product.media[1].preview_image
  endif

  case card_label_source
    when 'type'
      assign card_label = product.type
    when 'vendor'
      assign card_label = product.vendor
    else
      assign card_label = blank
  endcase
-%}
<li class="hc-card{% if second_image != blank %} hc-card--has-secondary{% endif %}" data-product-id="{{ product.id }}">
  <a href="{{ product.url | within: collection }}" class="hc-card__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {%- assign image_alt = product.featured_media.alt | default: product.title -%}
      {{
        product.featured_media.preview_image
        | image_url: width: 1200
        | image_tag:
          class: 'hc-card__image',
          sizes: sizes,
          widths: '300, 400, 500, 600, 800, 1000, 1200',
          loading: 'lazy',
          alt: image_alt
      }}
      {%- if second_image != blank -%}
        {{
          second_image
          | image_url: width: 1200
          | image_tag:
            class: 'hc-card__image hc-card__image--secondary',
            sizes: sizes,
            widths: '300, 400, 500, 600, 800, 1000, 1200',
            loading: 'lazy',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'hc-card__image hc-card__placeholder' }}
    {%- endif -%}

    {%- case badge -%}
      {%- when 'sold_out' -%}
        <span class="hc-badge hc-badge--sold-out">Sold out</span>
      {%- when 'low_stock' -%}
        <span class="hc-badge">Low stock</span>
      {%- when 'sale' -%}
        <span class="hc-badge">Sale</span>
    {%- endcase -%}
  </a>

  <div class="hc-card__info">
    {%- if card_label != blank -%}
      <p class="hc-card__label">{{ card_label }}</p>
    {%- endif -%}
    <h2 class="hc-card__title">
      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
    </h2>
    <p class="hc-card__price">
      {%- if product.price_varies -%}From {% endif -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="hc-card__price--sale">{{ product.price | money }}</span>
        <s class="hc-card__price--compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </p>
  </div>
</li>

{% stylesheet %}
  /* Grid */
  .hc-grid {
    display: grid;
    grid-template-columns: repeat(var(--hc-cols-mobile), minmax(0, 1fr));
    column-gap: var(--hc-gap-x);
    row-gap: var(--hc-gap-y);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .hc-grid {
      grid-template-columns: repeat(var(--hc-cols-tablet), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .hc-grid {
      grid-template-columns: repeat(var(--hc-cols), minmax(0, 1fr));
    }
  }

  /* Card */
  .hc-card {
    --hc-muted: #767676;
    --hc-border: #1a1a1a;

    position: relative;
    min-width: 0;
  }

  .hc-card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--hc-ratio, 4 / 5);
    overflow: hidden;
    background: var(--hc-image-bg, #f2f2f2);
  }

  .hc-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .hc-card__image--secondary {
    opacity: 0;
  }

  @media (hover: hover) {
    .hc-card--has-secondary:hover .hc-card__image--secondary {
      opacity: 1;
    }
  }

  .hc-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 3px 7px;
    border: 1px solid var(--hc-border);
    background: #fff;
    color: #000;
    font-family: var(--hc-label-font, "Courier New", Courier, ui-monospace, monospace);
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hc-badge--sold-out {
    border-color: #fff;
    background: #8c8c8c;
    color: #fff;
  }

  .hc-card__info {
    padding: 12px 12px 0;
  }

  .hc-card__label {
    margin: 0 0 3px;
    color: var(--hc-muted);
    font-family: var(--hc-label-font, "Courier New", Courier, ui-monospace, monospace);
    font-size: 10px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hc-card__title {
    margin: 0;
    font-family: inherit;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
  }

  .hc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .hc-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hc-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hc-card__price {
    margin: 3px 0 0;
    font-size: 11px;
    line-height: 1.3;
  }

  .hc-card__price--compare {
    margin-left: 4px;
    color: var(--hc-muted);
  }
{% endstylesheet %}
